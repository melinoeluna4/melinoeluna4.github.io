{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Group Astro and its integrations into one reviewable pull request",
      "groupName": "Astro",
      "matchPackageNames": ["astro", "@astrojs/**"]
    },
    {
      "description": "Group Tailwind CSS with its Vite plugin",
      "groupName": "Tailwind CSS",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/**"]
    },
    {
      "description": "Automerge patch updates only when CI is green",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Minor and major updates always need a human review",
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    }
  ]
}
