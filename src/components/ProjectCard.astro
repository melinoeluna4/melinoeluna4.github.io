---
import type { ProjectView } from "../lib/content-types";
import { formatDateRange } from "../lib/format-date";
import { projectStatusIcons, projectStatusLabels } from "../lib/project-status";

interface Props {
  project: ProjectView;
  index: number;
}

const { project, index } = Astro.props;
const titleId = `project-${project.slug}-title`;
const hasLinks = Boolean(project.repoUrl || project.demoUrl);
---

<article class="project-card surface-card" aria-labelledby={titleId}>
  <div class="project-card__visual" aria-hidden="true">
    <span class="project-card__index">{String(index).padStart(2, "0")}</span>
  </div>

  <div class="project-card__body">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <span
        class:list={[
          "status",
          project.status === "in_progress" ? "status--in-progress" : "status--completed",
        ]}
      >
        <span class="status__icon" aria-hidden="true">{projectStatusIcons[project.status]}</span>
        {projectStatusLabels[project.status]}
      </span>
      {
        project.startDate ? (
          <span class="mono text-small text-muted">
            {formatDateRange(project.startDate, project.endDate)}
          </span>
        ) : null
      }
    </div>

    <h3 class="project-card__title" id={titleId}>{project.title}</h3>
    <p class="project-card__description">{project.description}</p>

    <ul class="tag-list" aria-label={`Tecnologías de ${project.title}`}>
      {
        project.tags.map((tag) => (
          <li>
            <span class="chip">{tag}</span>
          </li>
        ))
      }
    </ul>

    {
      hasLinks ? (
        <div class="project-card__links">
          {project.repoUrl ? (
            <a
              class="link-arrow"
              href={project.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Repositorio de ${project.title} (se abre en una pestaña nueva)`}
            >
              Repositorio <span aria-hidden="true">↗</span>
            </a>
          ) : null}
          {project.demoUrl ? (
            <a
              class="link-arrow"
              href={project.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Demo de ${project.title} (se abre en una pestaña nueva)`}
            >
              Demo <span aria-hidden="true">↗</span>
            </a>
          ) : null}
        </div>
      ) : null
    }
  </div>
</article>
