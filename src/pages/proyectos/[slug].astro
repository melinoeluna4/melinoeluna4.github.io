---
import { render } from "astro:content";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import type { ProjectView } from "../../lib/content-types";
import { getProjectEntry, getProjects } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: ProjectView;
}

const { project } = Astro.props;
const entry = await getProjectEntry(project.slug);

if (!entry) {
  throw new Error(`Missing project entry for slug: ${project.slug}`);
}

const { Content } = await render(entry);
const projects = await getProjects();
const related = projects.filter((item) => item.slug !== project.slug).slice(0, 2);
---

<ProjectLayout project={project} related={related}>
  <Content />
</ProjectLayout>
