---
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProjects } from "../lib/projects";

const projects = await getProjects();
const completed = projects.filter((project) => project.status === "completed").length;
const inProgress = projects.length - completed;
const github = site.social.find((link) => link.label === "GitHub");
---

<BaseLayout
  title="Proyectos"
  description="Proyectos de backend, infraestructura y edge: Go, Rust, Docker, Cloudflare y automatización."
>
  <section class="page-header page-shell" aria-labelledby="proyectos-title">
    <p class="eyebrow">01 / Proyectos</p>
    <div class="mt-4 flex flex-wrap items-end justify-between gap-6">
      <h1 class="font-display text-display uppercase" id="proyectos-title">Proyectos</h1>
      <p class="lead max-w-measure">
        Sistemas pequeños con una idea grande: que el despliegue, el error y el siguiente paso se
        puedan entender sin abrir cinco pestañas.
      </p>
    </div>

    <div class="stat-grid mt-10">
      <div class="stat">
        <p class="stat__value">{String(projects.length).padStart(2, "0")}</p>
        <p class="stat__label">Total</p>
      </div>
      <div class="stat">
        <p class="stat__value">{String(completed).padStart(2, "0")}</p>
        <p class="stat__label">Completados</p>
      </div>
      <div class="stat">
        <p class="stat__value">{String(inProgress).padStart(2, "0")}</p>
        <p class="stat__label">En progreso</p>
      </div>
    </div>
  </section>

  <section class="page-shell section" aria-labelledby="lista-title">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Repositorios y demos</p>
        <h2 class="mt-3 text-heading" id="lista-title">Todos los proyectos</h2>
      </div>
      {
        github ? (
          <a class="link-arrow" href={github.url} target="_blank" rel="noopener noreferrer">
            Ver GitHub <span aria-hidden="true">↗</span>
            <span class="sr-only">(se abre en una pestaña nueva)</span>
          </a>
        ) : null
      }
    </div>

    {
      projects.length === 0 ? (
        <div class="empty-state mt-8">
          <p>Todavía no hay proyectos publicados.</p>
        </div>
      ) : (
        <div class="project-list mt-8">
          {projects.map((project, index) => (
            <ProjectCard project={project} index={index + 1} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
