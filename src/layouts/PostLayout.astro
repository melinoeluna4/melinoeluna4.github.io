---
import PostCard from "../components/PostCard.astro";
import type { PostView } from "../lib/content-types";
import { formatDate, toIsoDate } from "../lib/format-date";
import { tagHref } from "../lib/tag";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: PostView;
  related?: readonly PostView[];
}

const { post, related = [] } = Astro.props;
---

<BaseLayout
  title={post.title}
  description={post.description}
  type="article"
  publishedTime={post.pubDate}
  modifiedTime={post.updatedDate}
  tags={post.tags}
>
  <article class="page-shell section">
    <div class="mx-auto max-w-measure">
      <a class="link-arrow" href="/blog/">Volver al blog</a>

    <div class="mt-10 max-w-measure">
      <p class="eyebrow">Nota · {formatDate(post.pubDate)}</p>
      <h1 class="mt-4 text-heading">{post.title}</h1>
      <p class="lead mt-4">{post.description}</p>

      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
        <time class="mono text-small text-muted" datetime={toIsoDate(post.pubDate)}>
          Publicado el {formatDate(post.pubDate)}
        </time>
        {
          post.updatedDate ? (
            <span class="mono text-small text-muted">
              · Actualizado el{" "}
              <time datetime={toIsoDate(post.updatedDate)}>{formatDate(post.updatedDate)}</time>
            </span>
          ) : null
        }
      </div>

      <ul class="tag-list mt-5" aria-label={`Etiquetas de ${post.title}`}>
        {
          post.tags.map((tag) => (
            <li>
              <a class="chip" href={tagHref(tag)}>
                {tag}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="prose mt-10">
      <slot />
    </div>

    {
      related.length > 0 ? (
        <section class="mt-16 border-t-2 border-border-strong pt-8" aria-labelledby="related-title">
          <p class="eyebrow">Sigue leyendo</p>
          <h2 class="mt-3 text-heading" id="related-title">
            Otras notas
          </h2>
          <div class="post-list mt-6">
            {related.map((item) => (
              <PostCard post={item} />
            ))}
          </div>
        </section>
      ) : null
    }
    </div>
  </article>
</BaseLayout>
