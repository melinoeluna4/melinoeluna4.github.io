---
import PostList from "../../components/PostList.astro";
import SearchFilter from "../../components/SearchFilter.astro";
import TagList from "../../components/TagList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts, getTagIndex } from "../../lib/posts";

const posts = await getPosts();
const tags = await getTagIndex(posts);
---

<BaseLayout
  title="Blog"
  description="Notas cortas sobre DevOps, Go, Rust, Cloudflare y aprendizaje continuo."
>
  <section class="page-header page-shell" aria-labelledby="blog-title">
    <p class="eyebrow">03 / Blog</p>
    <div class="mt-4 flex flex-wrap items-end justify-between gap-6">
      <h1 class="font-display text-display uppercase" id="blog-title">Blog</h1>
      <p class="lead max-w-measure">
        Notas cortas sobre lo que rompo, lo que aprendo y las decisiones que vuelvo a revisar.
        Código incluido cuando hace falta.
      </p>
    </div>
  </section>

  <section class="page-shell section section--tight" aria-labelledby="notas-title">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Archivo</p>
        <h2 class="mt-3 text-heading" id="notas-title">Todas las notas</h2>
      </div>
      <p class="mono text-small text-muted">Ordenadas de más reciente a más antigua</p>
    </div>

    <div class="mt-6">
      <SearchFilter tags={tags} total={posts.length} />
    </div>

    <div class="mt-10">
      <PostList posts={posts} />
    </div>

    <div class="empty-state mt-6" id="filter-empty" role="status" hidden>
      <p>No hay notas que coincidan con ese filtro.</p>
      <a class="btn btn--secondary mt-4" href="/blog/">Ver todas las notas</a>
    </div>
  </section>

  <section class="page-shell section rule" aria-labelledby="etiquetas-title">
    <p class="eyebrow">Índice</p>
    <h2 class="mt-3 text-heading" id="etiquetas-title">Etiquetas</h2>
    <p class="lead mt-4">
      Cada etiqueta tiene su propia página, así el filtro también funciona sin JavaScript.
    </p>
    <div class="mt-8">
      <TagList tags={tags} />
    </div>
  </section>
</BaseLayout>
