---
import { render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import type { PostView } from "../../lib/content-types";
import { getPostEntry, getPosts, getRelatedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: PostView;
}

const { post } = Astro.props;
const entry = await getPostEntry(post.slug);

if (!entry) {
  throw new Error(`Missing blog entry for slug: ${post.slug}`);
}

const { Content } = await render(entry);
const posts = await getPosts();
const related = getRelatedPosts(post, posts);
---

<PostLayout post={post} related={related}>
  <Content />
</PostLayout>
