---
import PostCard from "../components/PostCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPosts } from "../lib/posts";
import { getFeaturedProjects, getProjectCount } from "../lib/projects";

const [featuredProjects, posts, projectCount] = await Promise.all([
  getFeaturedProjects(4),
  getPosts(),
  getProjectCount(),
]);

const recentPosts = posts.slice(0, 3);
const postCount = posts.length;
---

<BaseLayout title={site.name} description={site.description}>
  <section class="page-shell section grid-paper" aria-labelledby="hero-title">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">Portfolio · 2026 · España</p>
        <h1 class="hero-title mt-5 font-display text-display uppercase" id="hero-title">
          Melinoe <em>Luna</em>
        </h1>
        <p class="mt-4 font-display text-subheading">{site.role}</p>
        <p class="lead mt-5">
          Construyo APIs y despliegues que se pueden explicar, medir y repetir. Go, Rust y
          Cloudflare son mi caja de herramientas; la simplicidad es el objetivo.
        </p>

        <div class="focus-list mt-6">
          {site.focus.map((focus, index) => (
            <span class:list={["chip", index === 0 ? "chip--accent" : ""]}>{focus}</span>
          ))}
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn--primary" href="/proyectos/">Ver proyectos</a>
          <a class="btn btn--secondary" href="/sobre-mi/">Sobre mí</a>
          <a class="btn btn--ghost" href="/blog/">Leer el blog</a>
        </div>

        <div class="stat-grid mt-10">
          <div class="stat">
            <p class="stat__value">{String(projectCount).padStart(2, "0")}</p>
            <p class="stat__label">Proyectos</p>
          </div>
          <div class="stat">
            <p class="stat__value">{String(postCount).padStart(2, "0")}</p>
            <p class="stat__label">Notas publicadas</p>
          </div>
          <div class="stat">
            <p class="stat__value">{String(site.focus.length).padStart(2, "0")}</p>
            <p class="stat__label">Áreas de foco</p>
          </div>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <span class="hero-art__label">Portfolio / Backend / Edge</span>
        <span class="hero-art__index">ML</span>
        <span class="hero-art__stamp">Open to work</span>
        <span class="hero-art__dots"></span>
      </div>
    </div>
  </section>

  <div class="page-shell">
    <div class="band">
      <div class="band__inner">
        <span>Construyo sistemas que fallan de forma predecible.</span>
        <span>Go · Rust · Cloudflare</span>
      </div>
    </div>
  </div>

  <section class="page-shell section" aria-labelledby="enfoque-title">
    <p class="eyebrow">Enfoque</p>
    <h2 class="mt-3 text-heading" id="enfoque-title">Menos superficie, más intención</h2>

    <div class="mt-8 grid gap-8 md:grid-cols-3">
      <article class="border-t-2 border-border-strong pt-4">
        <p class="mono text-small text-muted">01</p>
        <h3 class="mt-2 text-subheading">APIs y servicios</h3>
        <p class="mt-2 text-ui text-muted">
          Servicios pequeños en Go y Rust, contratos claros y errores que se pueden diagnosticar.
        </p>
      </article>
      <article class="border-t-2 border-border-strong pt-4">
        <p class="mono text-small text-muted">02</p>
        <h3 class="mt-2 text-subheading">Infraestructura</h3>
        <p class="mt-2 text-ui text-muted">
          Docker, Linux, GitHub Actions y Cloudflare: entornos reproducibles y despliegues sin
          sorpresas.
        </p>
      </article>
      <article class="border-t-2 border-border-strong pt-4">
        <p class="mono text-small text-muted">03</p>
        <h3 class="mt-2 text-subheading">Aprendizaje continuo</h3>
        <p class="mt-2 text-ui text-muted">
          Notas técnicas y proyectos pequeños para convertir lo que estudio en algo que se pueda
          ejecutar.
        </p>
      </article>
    </div>
  </section>

  <section class="page-shell section rule" aria-labelledby="proyectos-title">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Trabajo seleccionado</p>
        <h2 class="mt-3 text-heading" id="proyectos-title">Proyectos destacados</h2>
      </div>
      <a class="link-arrow" href="/proyectos/">Todos los proyectos</a>
    </div>

    <div class="project-list mt-8">
      {
        featuredProjects.map((project, index) => (
          <ProjectCard project={project} index={index + 1} />
        ))
      }
    </div>
  </section>

  <section class="page-shell section rule" aria-labelledby="notas-title">
    <div class="two-col">
      <div>
        <p class="eyebrow">Cuaderno</p>
        <h2 class="mt-3 text-heading" id="notas-title">Notas recientes</h2>
        <p class="lead mt-4">
          Apuntes cortos sobre lo que rompo, lo que aprendo y lo que vuelvo a intentar.
        </p>

        <div class="post-list mt-8">
          {recentPosts.map((post) => <PostCard post={post} />)}
        </div>

        <a class="link-arrow mt-8" href="/blog/">Ir al blog</a>
      </div>

      <aside class="aside-note" aria-labelledby="ahora-title">
        <p class="eyebrow">Ahora</p>
        <h2 class="mt-3 text-subheading" id="ahora-title">Buscando el siguiente reto</h2>
        <p class="mt-3 text-ui text-muted">
          Acabo de terminar la carrera y estoy abierta a oportunidades junior, prácticas y
          proyectos de automatización.
        </p>

        <div class="mt-5">
          <p class="field__label">Encuéntrame</p>
          <ul class="tag-list mt-2">
            {
              site.social.map((link) => (
                <li>
                  <a
                    class="chip"
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${link.label} de ${site.name}: ${link.handle} (se abre en una pestaña nueva)`}
                  >
                    {link.label} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <a class="link-arrow mt-6" href="/sobre-mi/">Conóceme</a>
      </aside>
    </div>
  </section>
</BaseLayout>
